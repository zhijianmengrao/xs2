# Core service
WEB_HOST=0.0.0.0
WEB_PORT=8020
LOG_LEVEL=INFO
# DETERMINFLOW_DATA_DIR=F:/absolute/path/to/data  # 默认=BASE_DIR/data；相对路径会随进程 CWD 漂移（R39 B29）
# DETERMINFLOW_LOGS_DIR=F:/absolute/path/to/logs  # 默认=BASE_DIR/logs
# DETERMINFLOW_CONFIG_DIR=F:/absolute/path/to/config  # 默认=BASE_DIR/config

# Keep only the newest terminal Workflow Session records. Interactive and
# recoverable sessions are never counted. Set to 0 to discard terminal history.
SESSION_HISTORY_MAX_ENTRIES=1000

# Model credential referenced by config/models_config.json.
DEEPSEEK_API_KEY=

# Streaming safety valve for slow LLM providers (langchain-openai). Abort a
# streamed completion after this many seconds without any chunk. The packaged
# default is 120s, which free-tier / long-thinking models routinely exceed
# (observed 10+ min generations, R33 §3.1). Raise it globally here, or set the
# per-agent "stream_chunk_timeout" model param (编排页 → Agent → 模型参数 →
# 流式分块超时) for a single agent. A negative value disables the watchdog.
# LANGCHAIN_OPENAI_STREAM_CHUNK_TIMEOUT_S=600

# Optional: override config/extensions.json with comma-separated Plugin IDs.
# Use "none" only when you intentionally need a Core-only runtime.
# DETERMINFLOW_EXTENSIONS=none

# Optional browser and workspace settings
# Marketplace Skill packages: only Markdown files are allowed by default.
# Only the explicit value false disables extension checks; path/size checks remain.
MARKETPLACE_SKILL_FILE_TYPE_CHECK=true
MARKETPLACE_SKILL_ALLOWED_EXTENSIONS=.md
# CORS_ORIGINS=http://localhost:5173
# CORS_ALLOW_ALL=false
# CODING_WORKSPACE_COPY_ON_CREATE=true

# Community default: supervised local Workflow Executor Pool. Count applies
# only in process mode. Set mode to "inline" and count to 1 to fall back to
# the single-process path.
DETERMINFLOW_WORKFLOW_EXECUTOR_MODE=process
DETERMINFLOW_WORKFLOW_EXECUTOR_COUNT=4
