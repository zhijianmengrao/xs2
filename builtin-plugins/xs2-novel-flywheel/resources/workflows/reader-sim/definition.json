    "app": "novel-workbench",
    "role": "reader",
    "order": 90,
    "title": "模拟读者",
    "group": "质量检查",
    "description": "从读者视角判断看点、钩子、节奏和继续阅读意愿。",
    "artifact": "story/{chapter}/reader_report.json",
